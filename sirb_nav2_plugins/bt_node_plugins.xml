<library path="sirb_nav2_plugins_nodes">
  <class type="sirb_nav2_plugins::EnemyDetectedCondition" base_class_type="BT::ConditionNode">
    <description>
      检测是否发现敌人的条件节点,未使用
    </description>
  </class>
  <class type="sirb_nav2_plugins::SelectNearbyGoal" base_class_type="BT::ActionNodeBase">
    <description>
      在目标点周围采样并选择空闲点作为新目标
    </description>
  </class>
  <class type="sirb_nav2_plugins::ReplanCondition" base_class_type="BT::ConditionNode">
    <description>
      智能重规划条件节点：基于路径偏差、前方碰撞和时间间隔触发全局重规划
    </description>
  </class>
  <class type="sirb_nav2_plugins::PathGate" base_class_type="BT::ActionNodeBase">
    <description>
      将候选重规划路径与 FollowPath 使用的稳定跟踪路径解耦。
    </description>
  </class>
  <class type="sirb_nav2_plugins::LocalizationReadyCondition" base_class_type="BT::ActionNodeBase">
    <description>
      等待定位诊断进入可信 TRACKING 状态后放行规划控制链。
    </description>
  </class>
  <class type="sirb_nav2_plugins::HolePassModeController" base_class_type="BT::ActionNodeBase">
    <description>
      机器人位于洞口且当前导航目标指向对侧端口时切换过洞语义模式，到达另一端口区域后发送上升指令并恢复普通模式，不接管 FollowPath 控制。
    </description>
  </class>
  <class type="sirb_nav2_plugins::CommitTrajectoryAction" base_class_type="BT::ActionNodeBase">
    <description>
      提交最新的候选 MINCO 轨迹，仅在提交成功时更新 FollowPath 跟踪路径。
    </description>
  </class>
  <class type="sirb_nav2_plugins::GenerateMincoCandidateAction" base_class_type="BT::ActionNodeBase">
    <description>
      由全局路径异步生成候选 smooth path 与候选 MINCO 轨迹。
    </description>
  </class>
</library>
