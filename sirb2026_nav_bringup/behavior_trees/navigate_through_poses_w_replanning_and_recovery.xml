<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="8">
      <PipelineSequence name="NavigateWithReplanning">
        <LocalizationReady diagnostics_topics="ndt_omp_relocalization/diagnostics"
                           max_age="0.8"
                           required_ready_ticks="1"
                           required_state="trusted"
                           require_trusted="true"
                           allow_missing_diagnostics="false"/>
        <HolePassModeController global_frame="map"
                                robot_frame="gimbal_yaw_fake"
                                param_prefix="hole_pass"
                                goals="{goals}"
                                mode_service="navigation_mode_manager/set_navigation_mode"
                                mode_status_service="navigation_mode_manager/get_navigation_mode"
                                refresh_period_sec="0.05"/>
        <RateController hz="1.0">
          <RecoveryNode name="ComputePathThroughPoses"
                        number_of_retries="3">
            <RetryUntilSuccessful num_attempts="2">
              <ReactiveSequence>
                <RemovePassedGoals input_goals="{goals}"
                                   output_goals="{goals}"
                                   radius="0.7"/>
                <ComputePathThroughPoses server_timeout="1000" goals="{goals}"
                                         path="{candidate_path}"
                                         planner_id="GridBased"/>
                <GenerateMincoCandidate server_timeout="1000" input_path="{candidate_path}"
                                        smoothed_path="{candidate_smooth_path}"
                                        candidate_minco="{candidate_minco}"
                                        product_type="{candidate_product_type}"
                                        prefer_keep_active="{candidate_prefer_keep_active}"
                                        smoother_id="safe_geometric_smoother"
                                        server_name="safe_geometric_smoother/generate_minco_candidate"
                                        max_smoothing_duration="0.4"/>
                <CommitTrajectory server_timeout="1000" candidate_path="{candidate_smooth_path}"
                                  candidate_minco="{candidate_minco}"
                                  prefer_keep_active="{candidate_prefer_keep_active}"
                                  tracking_path="{tracking_path}"
                                  server_name="trajectory_manager/commit_trajectory"
                                  allow_keep_active_on_reject="true"/>
              </ReactiveSequence>
            </RetryUntilSuccessful>
            <ReactiveFallback name="ThroughPosesPlanFailureRecovery">
              <GoalUpdated/>
              <RoundRobin name="ThroughPosesPlanRecoveryActions">
                <BackUp backup_dist="0.35"
                        backup_speed="0.35"/>
                <Wait wait_duration="0.5"/>
              </RoundRobin>
            </ReactiveFallback>
          </RecoveryNode>
        </RateController>

        <RecoveryNode name="FollowPathRecovery"
                      number_of_retries="3">
          <FollowPath path="{tracking_path}"
                      controller_id="FollowPath"/>
          <BackUp backup_dist="0.35"
                  backup_speed="0.35"/>
        </RecoveryNode>
      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <BackUp backup_dist="0.35"
                  backup_speed="0.35"/>

          <Sequence name="ClearGlobalAndReplan">
            <ClearEntireCostmap name="ClearGlobalCostmap-Recovery"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="0.20"/>
            <RemovePassedGoals input_goals="{goals}"
                               output_goals="{goals}"
                               radius="0.7"/>
            <ComputePathThroughPoses server_timeout="1000" goals="{goals}"
                                     path="{candidate_path}"
                                     planner_id="GridBased"/>
            <GenerateMincoCandidate server_timeout="1000" input_path="{candidate_path}"
                                    smoothed_path="{candidate_smooth_path}"
                                    candidate_minco="{candidate_minco}"
                                    product_type="{candidate_product_type}"
                                    prefer_keep_active="{candidate_prefer_keep_active}"
                                    smoother_id="safe_geometric_smoother"
                                    server_name="safe_geometric_smoother/generate_minco_candidate"
                                    max_smoothing_duration="0.4"/>
            <CommitTrajectory server_timeout="1000" candidate_path="{candidate_smooth_path}"
                              candidate_minco="{candidate_minco}"
                              prefer_keep_active="{candidate_prefer_keep_active}"
                              tracking_path="{tracking_path}"
                              server_name="trajectory_manager/commit_trajectory"
                              allow_keep_active_on_reject="false"/>
          </Sequence>

          <Sequence name="ClearBothAndReplan">
            <ClearEntireCostmap name="ClearLocalCostmap-Recovery"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Recovery-2"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="0.25"/>
            <RemovePassedGoals input_goals="{goals}"
                               output_goals="{goals}"
                               radius="0.7"/>
            <ComputePathThroughPoses server_timeout="1000" goals="{goals}"
                                     path="{candidate_path}"
                                     planner_id="GridBased"/>
            <GenerateMincoCandidate server_timeout="1000" input_path="{candidate_path}"
                                    smoothed_path="{candidate_smooth_path}"
                                    candidate_minco="{candidate_minco}"
                                    product_type="{candidate_product_type}"
                                    prefer_keep_active="{candidate_prefer_keep_active}"
                                    smoother_id="safe_geometric_smoother"
                                    server_name="safe_geometric_smoother/generate_minco_candidate"
                                    max_smoothing_duration="0.4"/>
            <CommitTrajectory server_timeout="1000" candidate_path="{candidate_smooth_path}"
                              candidate_minco="{candidate_minco}"
                              prefer_keep_active="{candidate_prefer_keep_active}"
                              tracking_path="{tracking_path}"
                              server_name="trajectory_manager/commit_trajectory"
                              allow_keep_active_on_reject="false"/>
          </Sequence>

          <Wait wait_duration="1.0"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
